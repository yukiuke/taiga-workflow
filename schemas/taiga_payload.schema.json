{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.taiga-agentic-workflow/schemas/taiga_payload.schema.json",
  "title": "TaigaIngestPayload",
  "description": "Product Owner output for the Taiga ingest pipeline (Epic → Story → Task + sprints).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_slug",
    "velocity",
    "sprints",
    "epics",
    "warnings",
    "summary"
  ],
  "properties": {
    "project_slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9\\-]*$"
    },
    "velocity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sprint_capacity_points", "notes"],
      "properties": {
        "sprint_capacity_points": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "estimated_start", "estimated_finish"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "estimated_start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "estimated_finish": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["temp_id", "subject", "description", "stories"],
        "properties": {
          "temp_id": {
            "type": "string",
            "pattern": "^E[0-9]+$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "stories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "temp_id",
                "subject",
                "description",
                "needs_human_review",
                "points",
                "sprint_name",
                "tasks"
              ],
              "properties": {
                "temp_id": {
                  "type": "string",
                  "pattern": "^US[0-9]+$"
                },
                "subject": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "needs_human_review": {
                  "type": "boolean"
                },
                "points": {
                  "type": "number",
                  "minimum": 0
                },
                "sprint_name": {
                  "type": ["string", "null"]
                },
                "tasks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["temp_id", "subject", "description"],
                    "properties": {
                      "temp_id": {
                        "type": "string",
                        "pattern": "^T[0-9]+$"
                      },
                      "subject": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
